# OAuth-токен: https://oauth.yandex.ru/
TRACKER_OAUTH_TOKEN=your_oauth_token

# ID организации: Администрирование → Организации → поле ID
TRACKER_ORG_ID=your_org_id

# Для Yandex Cloud Organization вместо TRACKER_ORG_ID:
# TRACKER_CLOUD_ORG_ID=your_cloud_org_id

# Ключ очереди (например, PROJECT)
TRACKER_QUEUE=PROJECT

# Опционально: фильтр по проекту Трекера (если нужен вместо/вместе с очередью)
# TRACKER_PROJECT=Название проекта
